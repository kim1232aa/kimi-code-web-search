{
  "name": "web",
  "version": "0.4.0",
  "description": "Multi-provider web search, web fetch, social platform research (Xiaohongshu & X), per-session Search Mode policy, and standalone Web UI Dashboard for Kimi Code.",
  "keywords": [
    "web-search",
    "web-fetch",
    "exa",
    "tavily",
    "brave",
    "firecrawl",
    "jina",
    "searxng",
    "xiaohongshu",
    "x",
    "mcp"
  ],
  "license": "MIT",
  "skills": "./skills/",
  "commands": "./commands/",
  "systemPromptPath": "./SYSTEM.md",
  "mcpServers": {
    "s": {
      "command": "node",
      "args": ["./bin/mcp-server.mjs"],
      "cwd": "./",
      "toolTimeoutMs": 120000
    }
  },
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "command": "node ./hooks/user-prompt-submit.mjs",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "^(web_search|web_fetch|mcp__(?:plugin-web_s|plugin-kimi-code-web-search_web|web)__(web_search|web_fetch))$",
      "command": "node ./hooks/pre-tool-gate.mjs",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "(web|Web|search|Search|fetch|Fetch|url|URL|Url|scrape|Scrape|crawl|Crawl|extract|Extract|reader|Reader|browse|Browse|page|Page|source|Source|mcp|MCP|tavily|Tavily|firecrawl|Firecrawl|perplexity|Perplexity|jina|Jina|exa|Exa|serp|Serp|duckduckgo|DuckDuckGo|searxng|SearXNG|kagi|Kagi|linkup|Linkup|brave|Brave)",
      "command": "node ./hooks/post-tool-receipt.mjs",
      "timeout": 5
    },
    {
      "event": "PostToolUseFailure",
      "matcher": "(web|Web|search|Search|fetch|Fetch|url|URL|Url|scrape|Scrape|crawl|Crawl|extract|Extract|reader|Reader|browse|Browse|page|Page|source|Source|mcp|MCP|tavily|Tavily|firecrawl|Firecrawl|perplexity|Perplexity|jina|Jina|exa|Exa|serp|Serp|duckduckgo|DuckDuckGo|searxng|SearXNG|kagi|Kagi|linkup|Linkup|brave|Brave)",
      "command": "node ./hooks/post-tool-receipt.mjs",
      "timeout": 5
    },
    {
      "event": "SubagentStart",
      "command": "node ./hooks/subagent-activity.mjs",
      "timeout": 5
    },
    {
      "event": "SubagentStop",
      "command": "node ./hooks/subagent-activity.mjs",
      "timeout": 5
    },
    {
      "event": "TurnStarted",
      "matcher": "system_trigger",
      "command": "node ./hooks/turn-start.mjs",
      "timeout": 5
    },
    {
      "event": "SessionEnd",
      "command": "node ./hooks/session-end.mjs",
      "timeout": 5
    },
    {
      "event": "Stop",
      "command": "node ./hooks/stop-turn-gate.mjs",
      "timeout": 10
    }
  ],
  "interface": {
    "displayName": "Kimi Web Tools",
    "shortDescription": "Multi-provider web search & fetch gateway with Search Mode and Web UI Dashboard",
    "developerName": "kimi-code-web-search"
  }
}
